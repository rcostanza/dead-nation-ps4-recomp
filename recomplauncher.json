{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Dead Nation (PS4) - Recompiled",
  "repo": "rcostanza/dead-nation-ps4-recomp",
  "game": {
    "kind": "folder",
    "label": "The decrypted dump of your own PS4 copy (CUSA00236, version 1.00): the folder with eboot.bin, sce_module, sce_sys and stream.dat.",
    "check": { "file": "stream.dat" },
    "update": {
      "into": "update",
      "label": "The decrypted 1.03 update (a folder with eboot.bin and sce_sys, e.g. CUSA00236-patch). Required: other versions are refused.",
      "accepts": "folder",
      "optional": false
    }
  },
  "start": {
    "program": ["deadnation.exe", "deadnation"]
  },
  "prepare": {
    "program": ["deadnation-setup.exe", "deadnation-setup"],
    "args": ["--prepare", "--game", "{game}", "--update", "{install}/update"],
    "label": "Building the game image from your dump",
    "timeout": 600
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/save/settings.ini", "if": "{install}/save/settings.ini" },
        { "path": "{install}/settings.ini" }
      ]
    }
  ],
  "saves": ["{install}/save/savedata", "{install}/save/settings.ini"],
  "folders": {
    "saves": [{ "path": "{install}/save" }],
    "logs": [{ "path": "{install}/save/log" }],
    "game": [{ "path": "{install}" }]
  },
  "settings": [
    {
      "id": "display_mode",
      "label": "Window",
      "help": "Borderless covers the screen at the desktop's resolution. Fullscreen takes the screen's own mode. Windowed uses Window size.",
      "choices": [
        { "label": "Borderless", "set": { "display_mode": "borderless" } },
        { "label": "Fullscreen", "set": { "display_mode": "fullscreen" } },
        { "label": "Windowed", "set": { "display_mode": "windowed" } }
      ],
      "defaults": { "display_mode": "borderless" }
    },
    {
      "id": "output_resolution",
      "label": "Window size",
      "help": "The window's size in Windowed mode. With another aspect ratio the game picks that shape's size nearest in height.",
      "choices": [
        { "label": "1280 x 720", "set": { "output_resolution": "1280x720" } },
        { "label": "1600 x 900", "set": { "output_resolution": "1600x900" } },
        { "label": "1920 x 1080", "set": { "output_resolution": "1920x1080" } },
        { "label": "2560 x 1440", "set": { "output_resolution": "2560x1440" } },
        { "label": "3840 x 2160", "set": { "output_resolution": "3840x2160" } }
      ],
      "defaults": { "output_resolution": "1920x1080", "display_mode": "borderless" },
      "when": { "display_mode": "windowed" }
    },
    {
      "id": "render_resolution",
      "label": "Resolution",
      "help": "What the game draws at. 1080p is the PS4's own. 4K is about three times the GPU work of 1080p.",
      "choices": [
        { "label": "720p", "set": { "render_resolution": "720p" } },
        { "label": "1080p", "set": { "render_resolution": "1080p" } },
        { "label": "1440p", "set": { "render_resolution": "1440p" } },
        { "label": "4K", "set": { "render_resolution": "4k" } }
      ],
      "defaults": { "render_resolution": "1080p" }
    },
    {
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "help": "21:9 and 32:9 show more of the level to the sides, 4:3 and 16:10 more above and below. Menus and HUD stay 16:9. 16:9 is the PS4's.",
      "choices": [
        { "label": "16:9", "set": { "aspect_ratio": "16:9" } },
        { "label": "16:10", "set": { "aspect_ratio": "16:10" } },
        { "label": "4:3", "set": { "aspect_ratio": "4:3" } },
        { "label": "21:9", "set": { "aspect_ratio": "21:9" } },
        { "label": "32:9", "set": { "aspect_ratio": "32:9" } }
      ],
      "defaults": { "aspect_ratio": "16:9" }
    },
    {
      "id": "frame_rate",
      "label": "Frame rate",
      "help": "The game runs at normal speed at any of these; 30 is the PS4's. If your PC can't hold the rate, the game slows down instead of skipping frames.",
      "choices": [
        { "label": "30", "set": { "frame_rate": "30" } },
        { "label": "60", "set": { "frame_rate": "60" } },
        { "label": "90", "set": { "frame_rate": "90" } },
        { "label": "120", "set": { "frame_rate": "120" } },
        { "label": "144", "set": { "frame_rate": "144" } },
        { "label": "180", "set": { "frame_rate": "180" } },
        { "label": "240", "set": { "frame_rate": "240" } },
        { "label": "360", "set": { "frame_rate": "360" } }
      ],
      "defaults": { "frame_rate": "60" }
    },
    {
      "id": "vsync",
      "label": "VSync",
      "help": "On waits for the screen's refresh. Off shows the newest frame at each refresh, still without tearing.",
      "choices": [
        { "label": "On", "set": { "vsync": "1" } },
        { "label": "Off", "set": { "vsync": "0" } }
      ],
      "defaults": { "vsync": "1" }
    },
    {
      "id": "tearing",
      "label": "Tearing",
      "help": "With VSync off, shows each frame at once: the least input delay and no frame rate ceiling, with tearing.",
      "choices": [
        { "label": "Off", "set": { "tearing": "0" } },
        { "label": "On", "set": { "tearing": "1" } }
      ],
      "defaults": { "tearing": "0", "vsync": "1" },
      "when": { "vsync": "0" }
    },
    {
      "id": "sharpening",
      "label": "Sharpening",
      "help": "AMD FSR 1 RCAS: crisper edges without halos. F9 switches it in the game to compare.",
      "choices": [
        { "label": "On", "set": { "sharpening": "1" } },
        { "label": "Off", "set": { "sharpening": "0" } }
      ],
      "defaults": { "sharpening": "1" }
    },
    {
      "id": "audio_channels",
      "label": "Speakers",
      "help": "Automatic follows your sound device.",
      "choices": [
        { "label": "Automatic", "set": { "audio_channels": "auto" } },
        { "label": "Stereo", "set": { "audio_channels": "stereo" } },
        { "label": "5.1", "set": { "audio_channels": "5.1" } },
        { "label": "7.1", "set": { "audio_channels": "7.1" } }
      ],
      "defaults": { "audio_channels": "auto" }
    },
    {
      "id": "skip_intro",
      "label": "Intro",
      "help": "Skip goes straight to the main menu, past the logos, notices, intro movie and title screen.",
      "choices": [
        { "label": "Skip it", "set": { "skip_intro": "1" } },
        { "label": "Show it", "set": { "skip_intro": "0" } }
      ],
      "defaults": { "skip_intro": "1" }
    },
    {
      "id": "title_back_exits",
      "label": "Back on the title screen",
      "help": "Ask to close the game when Back is pressed on the \"Press OPTIONS\" screen.",
      "advanced": true,
      "choices": [
        { "label": "Asks to quit", "set": { "title_back_exits": "1" } },
        { "label": "Does nothing", "set": { "title_back_exits": "0" } }
      ],
      "defaults": { "title_back_exits": "1" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your saves, settings and the game's logs.", "open": "saves" },
    { "id": "shaders", "label": "Shader cache", "help": "Shaders the game has built, so later levels don't stutter. Clearing only helps if graphics look wrong after an update.", "clear": "game/shaders" }
  ]
}
